{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rackbook",
  "version": "2.3.6",
  "identifier": "local.rackbook.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Rackbook · 星际舰队",
        "url": "index.html",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 760,
        "center": true
      },
      {
        "label": "float",
        "title": "Rackbook 悬浮窗",
        "url": "float.html",
        "width": 300,
        "height": 240,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rackbook",
    "shortDescription": "Hand-drawn multi-server monitor · 手绘画风的服务器舰队监控",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "category": "DeveloperTool",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "openssh-client"
        ]
      }
    }
  }
}